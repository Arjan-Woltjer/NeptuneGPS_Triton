<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed (monochrome) layer, for Android 13 and later
  (NeptuneGPS_Triton#122).

  Same geometry as ic_launcher_foreground, drawn as one solid shape: the
  system takes only the alpha and tints it with the wallpaper's colours, so
  the droplet and the jets must read as a silhouette rather than by their own
  two colours. The jets are drawn as strokes of the same colour, which keeps
  the outline recognisable once everything is a single tone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,22 C44,36 38,44 38,52 a16,16 0 1,0 32,0 C70,44 64,36 54,22 Z"
        android:fillColor="#000000" />
    <path
        android:pathData="M54,72 L54,84"
        android:strokeColor="#000000"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M46,72 L39,80"
        android:strokeColor="#000000"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M62,72 L69,80"
        android:strokeColor="#000000"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
