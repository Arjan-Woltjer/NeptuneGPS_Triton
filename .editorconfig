# Matches NeptuneGPS Documentation/Conventions/FIRMWARE_CPLUSPLUS_CONVENTIONS.md
# section 6: four spaces, no tabs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
